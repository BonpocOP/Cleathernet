{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules/schema.json",
  "title": "Правила приоритетного сайта, схема 1 (docs/rules-schema.md)",
  "type": "object",
  "required": ["schema", "id", "version", "sites", "slots"],
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d+$" },
    "disabled": { "type": "boolean" },
    "minEngine": { "type": "string" },
    "notes": { "type": "string" },
    "scope": { "$ref": "#/$defs/selector" },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["hosts"],
        "properties": {
          "hosts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "paths": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "protect": { "type": "array", "items": { "$ref": "#/$defs/selector" } },
    "slots": { "type": "array", "maxItems": 40, "items": { "$ref": "#/$defs/slot" } }
  },
  "$defs": {
    "selector": { "type": "string", "minLength": 1, "maxLength": 300 },
    "weighted": {
      "oneOf": [
        { "type": "array", "items": { "type": "string", "maxLength": 300 } },
        {
          "type": "object",
          "required": ["list"],
          "properties": {
            "list": { "type": "array", "items": { "type": "string", "maxLength": 300 } },
            "weight": { "type": "number", "minimum": 0, "maximum": 10 }
          }
        }
      ]
    },
    "slot": {
      "type": "object",
      "required": ["id", "kind", "find", "root", "action"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "kind": { "enum": ["banner", "native", "sidebar", "popup", "interstitial"] },
        "disabled": { "type": "boolean" },
        "minEngine": { "type": "string" },
        "notes": { "type": "string" },
        "paths": { "type": "array", "items": { "type": "string" } },
        "find": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "selectors": { "$ref": "#/$defs/weighted" },
            "links": { "$ref": "#/$defs/weighted" },
            "attrs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "contains": { "type": "string" },
                  "equals": { "type": "string" },
                  "startsWith": { "type": "string" },
                  "weight": { "type": "number" }
                }
              }
            },
            "text": {
              "type": "object",
              "required": ["any"],
              "properties": {
                "any": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "in": { "$ref": "#/$defs/selector" },
                "maxLength": { "type": "integer", "minimum": 1, "maximum": 500 },
                "homoglyphs": { "type": "boolean" },
                "weight": { "type": "number" }
              }
            },
            "size": { "type": "boolean" }
          }
        },
        "score": {
          "type": "object",
          "properties": { "threshold": { "type": "number", "minimum": 0 } }
        },
        "root": {
          "type": "object",
          "required": ["strategy"],
          "properties": {
            "strategy": { "enum": ["grid-item", "closest", "overlay", "self"] },
            "selector": { "$ref": "#/$defs/selector" },
            "maxLevels": { "type": "integer", "minimum": 0, "maximum": 20 }
          }
        },
        "action": { "enum": ["collapse", "hide", "neutralize"] },
        "early": { "type": "boolean" },
        "cleanup": {
          "type": "object",
          "properties": {
            "body": { "$ref": "#/$defs/cleanupTarget" },
            "html": { "$ref": "#/$defs/cleanupTarget" }
          }
        }
      }
    },
    "cleanupTarget": {
      "type": "object",
      "properties": {
        "scrollLock": { "type": "boolean" },
        "blur": { "type": "boolean" },
        "classes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
