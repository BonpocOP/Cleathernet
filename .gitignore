# служебное
Thumbs.db
.DS_Store
*.log

# временная папка сборки (архив в dist/ версионируется)
build/

# скриншоты для разбора вёрстки — не часть расширения
*.png
!icons/*.png
!platform/icons/*.png

# отчёты и дампы ошибок для разбора — не часть расширения
bug.txt
*.txt

# инструменты разработки: зависимости, браузер для тестов, временные профили
dev/node_modules/
dev/.browsers/
dev/.profiles/
dev/.neighbors/

# сырые образцы страниц (MHTML, HAR, скриншоты) — тяжёлые, хранятся отдельно
test/fixtures/raw/
# образцы рекламы, вырезанные из чужих страниц (присланы пользователями из
# России) — не наши, в репозиторий не попадают никогда
test/fixtures/private/
test/fixtures/snippets/

# внутренние заметки и исследования — только локально
docs/

# кэш скачанных сборок (uBO Lite по vendor/ubol.json)
dev/.cache/

# архив Cleathernet для ручной проверки — ~10 МБ, в git не храним
dist/cleathernet-*.zip
